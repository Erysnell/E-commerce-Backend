# Copy this file to .env and fill in your own values.
# Generate a SECRET_KEY with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

SECRET_KEY=your-secret-key-must-be-at-least-32-bytes-long
DEBUG=True
ALLOWED_HOSTS=*

# Stripe (Dashboard > Developers > API keys — use Test mode while developing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Payment gateway strategy: which adapter in core/gateways/ to use
PAYMENT_GATEWAY=stripe

# CORS: origins allowed to call this API (frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
